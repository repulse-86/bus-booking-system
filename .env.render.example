APP_NAME="Bus Ticketing System"
APP_ENV=production
APP_DEBUG=false
# Set in the Render dashboard, or let the entrypoint derive it from RENDER_EXTERNAL_URL.
APP_KEY=base64:CHANGE_ME
APP_URL=https://your-service.onrender.com

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Render's free plan blocks outbound SMTP. Use an HTTP mail API later if needed.
MAIL_MAILER=log

# Reverb (deployed as a separate Render web service).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=bus-booking
REVERB_APP_KEY=bus-booking-key
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=bus-booking-reverb.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https

# Vite bakes these into the JS bundle at build time (not at runtime).
VITE_APP_NAME="Bus Ticketing System"
VITE_REVERB_APP_KEY=bus-booking-key
VITE_REVERB_HOST=bus-booking-reverb.onrender.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
